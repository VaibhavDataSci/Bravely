# Required. At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=
# Required for any /api route that uses the database
POSTGRES_URL=postgres://bravely:bravely_dev@localhost:5433/bravely
# Optional: enables the reports worker
REDIS_URL=
# Groq API key for speech-to-text, chat and evaluation (https://console.groq.com/keys)
GROQ_API_KEY=
# Optional model overrides
# GROQ_CHAT_MODEL=openai/gpt-oss-20b
# GROQ_EVAL_MODEL=openai/gpt-oss-120b
# GROQ_STT_MODEL=whisper-large-v3-turbo
PORT=5000
# Comma-separated frontend origins allowed by CORS and Socket.IO
CORS_ORIGINS=http://localhost:3000
JWT_EXPIRES_IN=7d
